{
  "name": "basket-shop-ui",
  "homepage": "https://Pupppppppxz.github.io/basket-shop-ui/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:next": "next dev -p 8080",
    "build": "tsc --noEmit && vite build",
    "build:next": "next build",
    "predeploy": "npm run build:github",
    "deploy": "gh-pages -d dist",
    "lint": "eslint .",
    "lint:next": "next lint",
    "preview": "vite preview",
    "start:next": "next start -p 8080",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "commit": "cz",
    "docker:build": "docker build -t basket-shop-ui .",
    "docker:run": "docker run -p 8080:8080 basket-shop-ui",
    "docker:compose:up": "docker-compose up -d basket-shop",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "ngrok:start": "docker-compose --profile ngrok up -d",
    "ngrok:start:local": "docker-compose --profile ngrok-local up -d",
    "ngrok:stop": "docker-compose --profile ngrok down",
    "ngrok:logs": "docker-compose logs -f ngrok",
    "deploy:ngrok": "npm run docker:compose:up && npm run ngrok:start",
    "deploy:ngrok:local": "npm run docker:compose:up && npm run ngrok:start:local"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "clsx": "^2.1.1",
    "next": "^16.0.7",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.3",
    "tailwind-merge": "^3.3.1",
    "vite-plugin-ssr": "^0.4.142"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@commitlint/cz-commitlint": "^19.2.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "commitizen": "^4.3.1",
    "daisyui": "^5.1.24",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint . --fix",
      "prettier --write ."
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write ."
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
